generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN    // everything, incl. users
  REVIEWER // qualified professional: approves & publishes rules
  EDITOR   // manages catalog, drafts rules
}

enum EvidenceGrade {
  A
  B
  C
}

enum RuleEffect {
  RECOMMEND
  CAUTION
  BLOCK
}

enum RuleStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(EDITOR)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
  rulesCreated Rule[]     @relation("RuleCreatedBy")
  rulesReviewed Rule[]    @relation("RuleReviewedBy")
}

model Supplement {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  summary       String
  evidenceGrade EvidenceGrade
  /// DosingConfig from @supplement/engine
  dosing        Json
  timing        String
  notes         String[]
  /// [{ title, url }]
  references    Json          @default("[]")
  active        Boolean       @default(true)
  sortOrder     Int           @default(0)
  /// { ms: { name, summary, timing, notes[] }, id: { ... } } — falls back to English
  translations  Json          @default("{}")
  products      Product[]
  rules         Rule[]
  updatedAt     DateTime      @updatedAt
}

model Product {
  id                   String         @id @default(cuid())
  supplement           Supplement     @relation(fields: [supplementId], references: [id], onDelete: Cascade)
  supplementId         String
  brand                String
  name                 String
  form                 String
  servingSizeG         Float
  activePerServingG    Float
  sugarPerServingG     Float          @default(0)
  servingsPerContainer Int
  allergens            String[]
  vegan                Boolean        @default(false)
  halalCertified       Boolean        @default(false)
  /// e.g. JAKIM, MUI, MUIS — who certified it halal
  halalBody            String?
  certifications       String[]
  /// Local registration / notification number (e.g. NPRA, HSA, BPOM), if any
  registrationNo       String?
  imageUrl             String?
  notes                String?
  active               Boolean        @default(true)
  prices               ProductPrice[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([supplementId])
}

model ProductPrice {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  /// ISO country: MY, SG, ID, TH, PH, VN
  country   String
  currency  String
  price     Float
  url       String?
  updatedAt DateTime @updatedAt

  @@unique([productId, country])
}

model Rule {
  id           String      @id @default(cuid())
  /// Stable key used in tests and logs, e.g. "creatine-block-ckd"
  key          String      @unique
  name         String
  /// null = global rule applying to every supplement
  supplement   Supplement? @relation(fields: [supplementId], references: [id], onDelete: Cascade)
  supplementId String?
  effect       RuleEffect
  /// ConditionNode JSON from @supplement/engine
  condition    Json
  message      String
  /// { ms: "…", id: "…" } — falls back to English
  translations Json        @default("{}")
  priority     Int         @default(0)
  status       RuleStatus  @default(DRAFT)
  createdBy    AdminUser?  @relation("RuleCreatedBy", fields: [createdById], references: [id])
  createdById  String?
  reviewedBy   AdminUser?  @relation("RuleReviewedBy", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
}

model AuditLog {
  id        String     @id @default(cuid())
  user      AdminUser? @relation(fields: [userId], references: [id])
  userId    String?
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime   @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/// Anonymous usage stats only — no profile, labs or other personal data.
model RecommendationEvent {
  id          String   @id @default(cuid())
  country     String
  goal        String
  recommended String[]
  blocked     String[]
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/// Affiliate program for one marketplace host. Applied only when someone clicks
/// a buy link; never used for ranking.
model AffiliateProgram {
  id        String   @id @default(cuid())
  /// Display name, e.g. "Shopee Malaysia"
  name      String
  /// Hostname, e.g. shopee.com.my (also covers subdomains)
  host      String   @unique
  /// https://… template with {url} (and optional {sub}), or query parameters to add
  template  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Anonymous count of buy-link clicks. No IP, no profile, no cookie.
model OutboundClick {
  id        String   @id @default(cuid())
  productId String
  country   String
  host      String
  affiliate Boolean
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Optional user account (off unless ACCOUNTS_ENABLED=true). No email, name or password:
/// sign-in is by passkey only. Created only after explicit consent.
model Account {
  id             String       @id @default(cuid())
  /// Version of the consent text the person agreed to, e.g. "2026-11-10"
  consentVersion String
  consentAt      DateTime
  createdAt      DateTime     @default(now())
  lastSeenAt     DateTime     @default(now())
  passkeys       Passkey[]
  checks         SavedCheck[]
}

model Passkey {
  /// WebAuthn credential ID (base64url)
  id         String   @id
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  String
  publicKey  Bytes
  counter    Int      @default(0)
  transports String[]
  createdAt  DateTime @default(now())

  @@index([accountId])
}

/// A saved check, encrypted with AES-256-GCM (ACCOUNTS_ENCRYPTION_KEY) before it reaches the database.
model SavedCheck {
  id        String   @id @default(cuid())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  /// The id the browser gave the check, so devices can merge without duplicates
  clientId  String
  savedAt   DateTime
  /// iv (12 bytes) + auth tag (16 bytes) + ciphertext
  payload   Bytes
  createdAt DateTime @default(now())

  @@unique([accountId, clientId])
}
