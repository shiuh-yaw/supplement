{
  "name": "@supplement/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@supplement/engine": "workspace:*",
    "bcryptjs": "3.0.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "dotenv-cli": "11.1.0"
  }
}
