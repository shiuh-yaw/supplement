# Postgres connection (local: docker compose up -d)
DATABASE_URL="postgresql://supplement:supplement@localhost:5432/supplement"

# Backoffice session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# First admin account created by `pnpm db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"

# Optional: enables "upload your lab report" (Claude reads the numbers). Leave empty to hide the feature.
ANTHROPIC_API_KEY=""
