{
  "name": "supplement",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @supplement/db generate",
    "db:migrate": "pnpm --filter @supplement/db migrate",
    "db:deploy": "pnpm --filter @supplement/db deploy",
    "db:seed": "pnpm --filter @supplement/db seed"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
