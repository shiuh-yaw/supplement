{
  "name": "supplement",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @supplement/db run generate",
    "db:migrate": "pnpm --filter @supplement/db run migrate",
    "db:deploy": "pnpm --filter @supplement/db run migrate:deploy",
    "db:seed": "pnpm --filter @supplement/db run seed"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
